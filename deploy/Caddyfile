{$DOMAIN} {
    @not_health not path /api/health
    log_skip @not_health
    log {
        output file /data/health/health.jsonl {
            roll_size 5MiB
            roll_keep 4
            roll_keep_for 168h
        }
        format filter {
            wrap json
            fields {
                request delete
                resp_headers delete
            }
        }
    }
    log_append request_id {http.request.uuid}
    log_append upstream_duration_ms {rp.upstream.duration_ms}
    log_append upstream_latency_ms {rp.upstream.latency_ms}
    encode zstd gzip
    reverse_proxy app:3000 {
        header_up X-Request-ID {http.request.uuid}
    }
}

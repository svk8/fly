# Токен вашего Telegram бота, полученный от @BotFather
BOT_TOKEN=1234567890:ABCDefGhIJklmnOPQRstUVwxYZ

# Строка подключения к базе данных.
# Для локальной разработки и MVP можно использовать SQLite:
DATABASE_URL=sqlite+aiosqlite:///./crowdship.db

# Для продакшена с PostgreSQL (раскомментируйте и настройте):
# DATABASE_URL=postgresql+asyncpg://postgres:secure_password@localhost:5432/crowdship_db

# ID администраторов через запятую (для сервисных уведомлений)
ADMIN_IDS=123456789,987654321

# Режим отладки
DEBUG=True

# Часовой пояс по умолчанию
TIMEZONE=Europe/Moscow

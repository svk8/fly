# One token for the Python bot and Telegram Mini App. Revoke the old exposed token.
BOT_TOKEN=REPLACE_WITH_NEW_BOT_TOKEN
# Local Docker preview needs no public address. For a VPS, set both values.
APP_URL=
DOMAIN=localhost
WEB_PORT=3000
# Shared SQLAlchemy database, relative to the directory where Python is started.
DATABASE_URL=sqlite+aiosqlite:///./data/crowdship.db
ADMIN_IDS=
DEBUG=false
TIMEZONE=Europe/Moscow
# Telegram updates are consumed ONLY by the Python bot (long polling).
BOT_POLLING=true
# Local Node development proxy; Docker Compose sets its own internal URL.
BOT_API_URL=http://127.0.0.1:8000
PORT=3000
API_PORT=8000
API_HOST=127.0.0.1

# Optional GlitchTip projects: backend and browser errors. DSNs are public ingest keys.
GLITCHTIP_DSN=
GLITCHTIP_FRONTEND_DSN=
MONITORING_ENVIRONMENT=development
